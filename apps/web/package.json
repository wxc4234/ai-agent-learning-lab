		"test:workspaces": "node --experimental-strip-types --test \"test/features/workspaces/**/*.test.ts\"",
		"test:state": "node --experimental-strip-types --test \"test/features/chat/**/*.test.ts\""
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
