# 复制本文件并重命名为 .env；真实密钥只保存在本机，绝不提交。
DEEPSEEK_API_KEY=在这里填入你的key

# 模型与人民币价格。
# 当前默认对应 deepseek-v4-flash；官方价格变化或切换模型时必须同步更新。
DEEPSEEK_MODEL=deepseek-v4-flash

# 单次 Agent 运行累计 Token 达到该值后，不再继续工具调用和下一步模型请求。
# 这是项目的续跑预算，不代表模型上下文窗口。
AGENT_MAX_TOTAL_TOKENS=8000

# 高峰时段：北京时间工作日 09:00-12:00、14:00-18:00。
DEEPSEEK_PEAK_CACHE_HIT_INPUT_CNY_PER_MILLION=0.10
DEEPSEEK_PEAK_CACHE_MISS_INPUT_CNY_PER_MILLION=3.0
DEEPSEEK_PEAK_OUTPUT_CNY_PER_MILLION=9.0

# 空闲时段：工作日其他时间以及周末。
DEEPSEEK_OFF_PEAK_CACHE_HIT_INPUT_CNY_PER_MILLION=0.05
DEEPSEEK_OFF_PEAK_CACHE_MISS_INPUT_CNY_PER_MILLION=1.5
DEEPSEEK_OFF_PEAK_OUTPUT_CNY_PER_MILLION=4.5

# Docker Compose 启动的本地 PostgreSQL；仅用于学习环境。
DATABASE_URL=postgresql+psycopg://agent_app:agent_local_password@127.0.0.1:5432/agent_lab

# Docker Compose 启动的本地 Redis；用于跨进程取消流式 Agent Run。
REDIS_URL=redis://127.0.0.1:6379/0

# 本地 HTTP 调试；生产 HTTPS 必须设为 true。
LOGIN_COOKIE_SECURE=false
# JSON 数组，精确匹配前端来源；生产替换为实际 HTTPS 来源。
LOGIN_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 本地启动脚本会生成并同步随机内部凭证；不能将本地模式服务暴露到公网。
APP_MODE=local
LOCAL_RUNTIME_TOKEN=

# 每个 API 进程的聊天并发容量，包含响应与后台收尾；不是跨进程总限额。
AGENT_MAX_CONCURRENT_EXECUTIONS=2
